---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  // 1-based position on the index, shown zero-padded in the accent tag.
  rank: number;
}

const { project, rank } = Astro.props;
const { title, tagline, stack, year, repo } = project.data;
const writeup = `/projects/${project.id}/`;
---

<div class="row">
  <span class="rank"><span class="tag">{String(rank).padStart(2, '0')}</span></span>
  <div>
    <div class="titleline"><a href={writeup}><span class="name">{title}</span>: {tagline}</a></div>
    <div class="subtext">{stack.join(', ')} · {year} · <a href={writeup}>write-up</a> · <a href={repo}>source</a></div>
  </div>
</div>
