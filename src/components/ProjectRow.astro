---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  // Index rows are numbered and link to the write-up. The item page has no
  // rank, uses the title as its h1, and links the title out to the source.
  rank?: number;
}

const { project, rank } = Astro.props;
const { title, tagline, stack, year, repo } = project.data;
const isItem = rank === undefined;
const writeup = `/projects/${project.id}/`;
const Title = isItem ? 'h1' : 'div';
---

<div class:list={['row', { item: isItem }]}>
  {!isItem && <span class="rank">{rank}.</span>}
  <div>
    <Title class="titleline"><a href={isItem ? repo : writeup}><span class="name">{title}</span>: {tagline}</a></Title>
    <div class="subtext">{stack.join(', ')} · {year} · {!isItem && <><a href={writeup}>write-up</a> · </>}<a href={repo}>source</a></div>
  </div>
</div>
