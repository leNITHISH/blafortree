---
import { links } from '../links';

interface Props {
  title: string;
  description?: string;
  active?: 'projects' | 'about';
}

const {
  title,
  description = 'Nithish Siva Kumar: systems and embedded software. Storage engines, CLI tools, ESP32s and an 8051.',
  active,
} = Astro.props;
// No canonical on the 404 page; it's served at whatever URL was missing.
const canonical = Astro.url.pathname.startsWith('/404') ? undefined : new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="page">
      <header class="bar">
        <a class="logo" href="/" aria-label="Home">N</a>
        <span class="pagetop">
          <b class="sitename"><a href="/">Nithish Siva Kumar</a></b>
          <a href="/" aria-current={active === 'projects' ? 'page' : undefined}>projects</a> | <a href="/about/" aria-current={active === 'about' ? 'page' : undefined}>about</a>
        </span>
        <span class="pagetop right"><a href={links.github}>github</a></span>
      </header>

      <main>
        <slot />
      </main>

      <footer>
        <div class="rule"></div>
        <p class="yclinks">
          <a href={links.github}>github</a> | <a href={links.linkedin}>linkedin</a> | <a href={links.leetcode}>leetcode</a> | <a href={links.email}>email</a> | <a href={links.source}>source</a>
        </p>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --orange: #ff6600;
    --beige: #f6f6ef;
    --gray: #828282;
    --font: Verdana, Geneva, sans-serif;
  }

  body {
    margin: 0;
    padding: 8px;
    background: #fff;
    color: var(--gray);
    font-family: var(--font);
    font-size: 10pt;
  }

  .page {
    width: 85%;
    margin: 0 auto;
    background: var(--beige);
  }

  a {
    color: #000;
    text-decoration: none;
  }

  /* Header bar */
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    padding: 2px;
    background: var(--orange);
  }

  .logo {
    display: block;
    flex: none;
    width: 18px;
    height: 18px;
    border: 1px solid #fff;
    color: #fff;
    font-weight: bold;
    line-height: 18px;
    text-align: center;
  }

  .pagetop {
    color: #222;
    line-height: 12pt;
  }

  .pagetop a[aria-current='page'] {
    color: #fff;
  }

  .sitename {
    margin: 0 5px 0 2px;
  }

  .right {
    margin-left: auto;
    padding-right: 4px;
  }

  main {
    padding: 10px 0;
  }

  /* Ranked rows, shared by the index and item pages */
  .items {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    display: flex;
    align-items: flex-start;
    margin-bottom: 5px;
  }

  .rank {
    flex: none;
    width: 2.2em;
    padding-right: 2px;
    text-align: right;
  }

  .votearrow {
    flex: none;
    width: 10px;
    height: 10px;
    margin: 3px 4px 6px 2px;
    background: #9a9a9a;
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }

  .titleline a:visited {
    color: var(--gray);
  }

  .sitestr {
    font-size: 8pt;
  }

  .subtext {
    font-size: 7pt;
  }

  .subtext a {
    color: var(--gray);
  }

  .subtext a:hover,
  .yclinks a:hover {
    text-decoration: underline;
  }

  /* Text under a header row: intro blurbs and write-ups */
  .toptext {
    margin: 0 0 10px;
    padding: 0 10px 0 calc(2.2em + 18px);
  }

  .post {
    max-width: 720px;
    padding: 6px 10px 0 18px;
    color: #000;
    line-height: 1.45;
  }

  .post a {
    text-decoration: underline;
  }

  .post h2 {
    margin: 1.4em 0 0.4em;
    font-size: 10pt;
  }

  .post p,
  .post ul,
  .post pre,
  .post table {
    margin: 0 0 0.8em;
  }

  .post ul {
    padding-left: 1.5em;
  }

  .post li {
    margin-bottom: 0.3em;
  }

  .post pre {
    padding: 2px;
    overflow-x: auto;
  }

  .post code {
    font-family: monospace;
    font-size: 9pt;
  }

  /* Long inline paths and URLs would otherwise push narrow screens sideways. */
  .post :not(pre) > code {
    overflow-wrap: anywhere;
  }

  .post table {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 9pt;
  }

  .post th,
  .post td {
    padding: 2px 12px 2px 0;
    border-bottom: 1px solid #e3e3d9;
    text-align: left;
    vertical-align: top;
  }

  .post th {
    color: var(--gray);
    font-weight: normal;
  }

  /* Footer */
  footer {
    padding-bottom: 10px;
  }

  .rule {
    height: 2px;
    background: var(--orange);
  }

  .yclinks {
    margin: 12px 0 0;
    padding: 0 10px;
    font-size: 8pt;
    text-align: center;
  }

  @media (max-width: 750px) {
    body {
      padding: 0;
    }

    .page {
      width: 100%;
    }

    .row {
      padding-right: 8px;
    }

    .pagetop,
    .titleline {
      font-size: 11pt;
      line-height: 20px;
    }

    .subtext {
      font-size: 9pt;
    }

    .votearrow {
      transform: scale(1.3);
      margin-right: 6px;
    }
  }
</style>
