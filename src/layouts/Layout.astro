---
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource/ibm-plex-mono/400.css';
import plexLatin from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url';
import { links } from '../links';

interface Props {
  title: string;
  description?: string;
  active?: 'projects' | 'about';
}

const {
  title,
  description = 'Nithish Siva Kumar: systems and embedded software. Storage engines, CLI tools, ESP32s and an 8051.',
  active,
} = Astro.props;
// No canonical on the 404 page; it's served at whatever URL was missing.
const canonical = Astro.url.pathname.startsWith('/404') ? undefined : new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={plexLatin} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <header class="bar">
      <div class="wrap bar-inner">
        <a class="logo" href="/" aria-label="Home">N</a>
        <a class="sitename" href="/">Nithish Siva Kumar</a>
        <nav>
          <a href="/" aria-current={active === 'projects' ? 'page' : undefined}>projects</a>
          <a href="/about/" aria-current={active === 'about' ? 'page' : undefined}>about</a>
        </nav>
        <a class="right" href={links.github}>github</a>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="wrap">
      <a href={links.github}>github</a> · <a href={links.linkedin}>linkedin</a> · <a href={links.leetcode}>leetcode</a> · <a href={links.email}>email</a> · <a href={links.source}>source</a>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --cream: #f5efe0;
    --orange: #dd5a12;
    --ink: #111;
    --gray: #6b6558;
    --rule: #e0d6c1;
    --code-bg: #ebe3cf;
    --sans: 'IBM Plex Sans Variable', system-ui, sans-serif;
    --mono: 'IBM Plex Mono', ui-monospace, monospace;
  }

  html {
    background: var(--cream);
  }

  body {
    margin: 0;
    background: var(--cream);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 17px;
    font-weight: 460;
    line-height: 1.55;
  }

  a {
    color: var(--ink);
    text-decoration: none;
  }

  .wrap {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Header bar */
  .bar {
    background: var(--orange);
  }

  .bar-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 18px;
    min-height: 50px;
  }

  .logo {
    flex: none;
    width: 24px;
    height: 24px;
    border: 2px solid #fff;
    color: #fff;
    font-weight: 700;
    line-height: 24px;
    text-align: center;
  }

  .sitename {
    font-size: 18px;
    font-weight: 700;
  }

  .bar nav {
    display: flex;
    gap: 16px;
  }

  .bar nav a,
  .bar .right {
    font-weight: 560;
  }

  .bar a:hover,
  .bar nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  .bar .right {
    margin-left: auto;
  }

  main.wrap {
    padding-top: 32px;
    padding-bottom: 48px;
  }

  /* Ranked rows, shared by the index and item pages */
  .lede {
    margin: 0 0 28px;
    padding-left: 40px;
  }

  .items {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .items li + li {
    margin-top: 20px;
  }

  .row {
    display: grid;
    grid-template-columns: 30px 1fr;
    column-gap: 10px;
  }

  .row.item {
    grid-template-columns: 1fr;
  }

  .rank {
    color: var(--gray);
    font-size: 19px;
    font-variant-numeric: tabular-nums;
    line-height: 1.35;
    text-align: right;
  }

  .titleline {
    margin: 0;
    font-size: 19px;
    font-weight: 480;
    line-height: 1.35;
  }

  h1.titleline {
    font-size: 26px;
  }

  .titleline .name {
    font-weight: 680;
  }

  .titleline a:hover {
    color: var(--orange);
  }

  .subtext {
    margin-top: 4px;
    color: var(--gray);
    font-size: 15px;
  }

  .subtext a {
    color: var(--gray);
    white-space: nowrap;
  }

  .subtext a:hover,
  footer a:hover {
    text-decoration: underline;
  }

  /* Write-ups */
  .post {
    max-width: 68ch;
    margin-top: 28px;
    line-height: 1.65;
  }

  .lede a,
  .post a {
    text-decoration: underline;
    text-decoration-color: var(--orange);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .post h2 {
    margin: 2em 0 0.5em;
    font-size: 21px;
    font-weight: 680;
    line-height: 1.3;
  }

  .post strong {
    font-weight: 680;
  }

  .post p,
  .post ul,
  .post pre,
  .post table {
    margin: 0 0 1.1em;
  }

  .post ul {
    padding-left: 1.3em;
  }

  .post li {
    margin-bottom: 0.5em;
  }

  .post li::marker {
    color: var(--orange);
  }

  .post code {
    font-family: var(--mono);
    font-size: 0.86em;
  }

  /* Long inline paths and URLs would otherwise push narrow screens sideways. */
  .post :not(pre) > code {
    padding: 0.1em 0.2em;
    border-radius: 3px;
    background: var(--code-bg);
    overflow-wrap: anywhere;
  }

  .post pre {
    padding: 14px 16px;
    overflow-x: auto;
    border-radius: 4px;
    background: var(--code-bg);
    line-height: 1.5;
  }

  .post pre code {
    font-size: 14px;
  }

  .post table {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 15.5px;
    line-height: 1.45;
  }

  .post th,
  .post td {
    padding: 7px 20px 7px 0;
    border-bottom: 1px solid var(--rule);
    text-align: left;
    vertical-align: top;
  }

  .post th {
    border-bottom: 2px solid #b9ad93;
    font-weight: 650;
  }

  /* Footer */
  footer.wrap {
    padding-top: 18px;
    padding-bottom: 36px;
    border-top: 2px solid var(--orange);
    color: var(--gray);
    font-size: 15px;
    text-align: center;
  }

  footer a {
    font-weight: 540;
  }

  @media (max-width: 600px) {
    body {
      font-size: 16px;
    }

    .wrap {
      padding: 0 16px;
    }

    .bar-inner {
      column-gap: 14px;
    }

    /* github is in the footer too; this keeps the bar on one line. */
    .bar .right {
      display: none;
    }

    .titleline,
    .rank {
      font-size: 18px;
    }

    h1.titleline {
      font-size: 22px;
    }

    .post {
      font-size: 16.5px;
    }
  }
</style>
