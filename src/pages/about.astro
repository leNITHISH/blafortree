---
import Layout from '../layouts/Layout.astro';
import { links } from '../links';
---

<Layout title="about | Nithish Siva Kumar" active="about">
  <h1 class="titleline">Nithish Siva Kumar <span class="handle">leNITHISH</span></h1>
  <table class="profile">
    <tbody>
      <tr>
        <th scope="row">about</th>
        <td>
          Software engineer. I like low-level systems, low-power devices, CLI tools and core CS fundamentals. I run
          Arch and write code in Neovim.
        </td>
      </tr>
      <tr>
        <th scope="row">languages</th>
        <td>C, C++, Go, Java, Python, JavaScript</td>
      </tr>
      <tr>
        <th scope="row">hardware</th>
        <td>ESP32, 8051 (AT89S52), I2C sensors</td>
      </tr>
      <tr>
        <th scope="row">tools</th>
        <td>Arch Linux, Neovim, Git, DuckDB</td>
      </tr>
      <tr>
        <th scope="row">core cs</th>
        <td>operating systems, computer networks, data structures and algorithms</td>
      </tr>
      <tr>
        <th scope="row">also</th>
        <td>Battery Management System (BMS) for Greenergy, an industry project. The code isn't public.</td>
      </tr>
      <tr>
        <th scope="row">links</th>
        <td>
          <a href="/">projects</a> · <a href={links.github}>github</a> · <a href={links.linkedin}>linkedin</a> · <a href={links.leetcode}>leetcode</a> · <a href={links.email}>email</a>
        </td>
      </tr>
    </tbody>
  </table>
</Layout>

